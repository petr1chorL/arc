{
  "name": "arc-one-agentic-os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run typecheck:netlify && vite build",
    "deploy:check": "node scripts/verify-deployment.mjs",
    "deploy:check:live": "node scripts/check-live-deployment.mjs",
    "lint": "oxlint",
    "test": "vitest",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck:netlify": "tsc --noEmit -p netlify/tsconfig.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@netlify/async-workloads": "^0.0.106",
    "@netlify/database": "^2.0.1",
    "@xyflow/react": "^12.11.1",
    "cron-parser": "4.9.0",
    "hash-wasm": "4.12.0",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.0",
    "@netlify/vite-plugin": "^3.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
